menu "wasp"

config WASP_WORKER
	bool "Worker role: accept a coordinator and execute WASM modules"
	default y
	help
	  The classic wasp node: WAMR runtime, agent + executor threads,
	  the listening TCP socket, and ANNOUNCE broadcasts. Disable for
	  a conductor-only build that spends its RAM on coordinating
	  other nodes instead of running modules (also set CONFIG_WAMR=n
	  there to drop the runtime).

config WASP_AGENT_PORT
	int "TCP port the agent listens on"
	default 4242

config WASP_WAMR_HEAP_POOL_SIZE
	int "Static heap pool handed to WAMR (bytes)"
	default 90112
	help
	  All WASM module memory (module structures, linear memory, exec
	  stacks) is allocated from this pool. A standard clang-built module
	  needs one contiguous 64 KiB WASM page for linear memory plus
	  runtime overhead, so this must comfortably exceed 64 KiB. Tune per
	  board in boards/<board>.conf.

config WASP_MAX_MODULE_SIZE
	int "Maximum accepted .wasm module size (bytes)"
	default 32768

config WASP_WASM_STACK_SIZE
	int "WASM execution stack size (bytes, from the WAMR pool)"
	default 4096

config WASP_WASM_HEAP_SIZE
	int "Per-module-instance app heap size (bytes)"
	default 4096
	help
	  Backs malloc() inside the WASM module (libc-builtin). Carved from
	  the module's memory space at instantiation time.

config WASP_WIFI_SSID
	string "WiFi SSID (boards with WiFi only)"
	default ""
	help
	  Network the node joins before starting DHCP. Do NOT put real
	  credentials in committed files: create app/wifi_credentials.conf
	  (gitignored, merged automatically — see README) instead.

config WASP_WIFI_PSK
	string "WiFi passphrase (WPA2-PSK; empty = open network)"
	default ""

config WASP_RPC_TIMEOUT_MS
	int "Remote-memory RPC timeout (ms)"
	default 5000
	help
	  How long a wasp.* host function waits for the coordinator to
	  answer a MEM_READ/MEM_WRITE/LOCK/... request before giving up and
	  raising a WASM exception on the calling module.

config WASP_WIFI_POWERSAVE
	bool "Leave WiFi chip power save enabled"
	depends on WIFI
	help
	  The WiFi driver enables chip power save (PM2) by default. That
	  adds beacon-interval latency bursts to everything that crosses
	  the radio — remote-memory RPCs, and on the Pico W even status
	  LED writes (the LED hangs off the WiFi chip), which visibly
	  mangles the blink patterns. wasp nodes are usually mains/USB
	  powered, so wasp disables power save after connecting; enable
	  this only for battery-powered nodes that prefer power over
	  latency.

config WASP_STATUS_LED
	bool "Drive a status LED (needs an led0 devicetree alias)"
	default y
	help
	  Blink patterns show network state at a glance; the IDENTIFY
	  command strobes it so a specific board can be located. No-op on
	  boards without an led0 alias.

config WASP_ANNOUNCE_PORT
	int "UDP port for discovery broadcasts"
	default 4243

config WASP_ANNOUNCE_INTERVAL
	int "Seconds between ANNOUNCE broadcasts"
	default 5

config WASP_PEER
	bool "Peer (job-owner) role: coordinate work on other nodes"
	help
	  Compiles the libwasp core into the firmware so this node can
	  dial other nodes, push modules, call functions, and serve
	  remote-memory regions from its own RAM — i.e. play the
	  coordinator role toward its peers. Worker-only nodes leave
	  this off and pay nothing.

config WASP_PEER_RX_BUF
	int "Peer connection receive buffer (bytes)"
	depends on WASP_PEER
	default 2048
	help
	  Caps inbound frames on an outbound peer connection, including
	  the worker's bulk MEM_WRITEs — size it to the largest write a
	  delegated module makes (e.g. one framebuffer tile) plus 4.

config WASP_PEER_THREAD_STACK_SIZE
	int "Peer driver thread stack size"
	depends on WASP_PEER
	default 4096

config WASP_PEER_MAX_PEERS
	int "Most simultaneous outbound peer connections"
	depends on WASP_PEER
	default 8
	help
	  Sizes the peer-API handle table: one wasp_node plus one
	  WASP_PEER_RX_BUF receive buffer per slot (statically
	  allocated; unreferenced tables are garbage-collected out of
	  builds that do not use the peer API).

config WASP_PEER_SMOKE
	bool "Run the peer-role smoke test at boot"
	depends on WASP_PEER
	help
	  Boot-time self-test of the peer role: dial a worker, push the
	  embedded remote-memory test module, and verify its wasp.*
	  RPCs are served from this node's RAM. Result is logged as
	  PEER SMOKE: PASS/FAIL. Needs tools/remote_module.wasm built
	  (tools/build_test_module.sh).

config WASP_PEER_SMOKE_HOST
	string "Worker IP the smoke test dials"
	depends on WASP_PEER_SMOKE
	default "10.0.0.183"

config WASP_CONDUCTOR
	bool "Conductor demo: discover workers and render the Mandelbrot"
	select WASP_PEER
	help
	  Boot-time demo of firmware-driven orchestration: listen for
	  worker ANNOUNCE broadcasts, push the embedded Mandelbrot
	  module to every free worker, host the framebuffer and work
	  counter in this node's RAM, and print progress plus the
	  finished fractal on the serial console. Needs
	  tools/mandelbrot_module.wasm (tools/build_test_module.sh).

config WASP_CONDUCTOR_DISCOVER_S
	int "Seconds to listen for worker ANNOUNCEs"
	depends on WASP_CONDUCTOR
	default 8

config WASP_CONDUCTOR_CHAOS
	bool "Kill one worker's connection mid-render (resilience demo)"
	depends on WASP_CONDUCTOR
	help
	  Once a quarter of the tiles are done, the conductor drops its
	  connection to the last worker, then re-issues that worker's
	  lost tiles to the survivors at the end — the firmware version
	  of the Python demo's --chaos flag.

config WASP_KSZ8794_STORM_PROTECT
	bool "Enable broadcast storm protection on the switch's external ports"
	default y
	help
	  Limits ingress broadcast traffic on the three external ports to the
	  KSZ8794's reset-default rate of 1% of 100BT (74 64-byte blocks per
	  50 ms). Port 4, the MCU side, is deliberately left unlimited so that
	  wasp's own broadcast ANNOUNCE discovery is never throttled.

config WASP_KSZ8794_HW_RESET
	bool "Pulse the switch's RST# at boot"
	help
	  Normally unnecessary: R6/C32 hold RST# low for roughly 100 ms at
	  power-on, well past the 10 ms the data sheet requires, and every
	  register this firmware writes is idempotent on a warm restart.

	  Dangerous once the clock tree is moved to HSE, because HSE is fed
	  from the switch's REFCLKO: holding the switch in reset then stops
	  the clock the CPU is running from. Only enable while on HSI.

config WASP_NET_THREAD_STACK_SIZE
	int "Network handler thread stack size"
	default 4096

config WASP_AGENT_THREAD_STACK_SIZE
	int "Agent thread stack size"
	default 4096

config WASP_EXEC_THREAD_STACK_SIZE
	int "WASM executor thread stack size"
	default 8192

endmenu

source "Kconfig.zephyr"
