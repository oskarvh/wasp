# west-managed dependencies and workspace metadata
/deps/
/.west/

# python virtualenv
/.venv/

# vscode settings
/.vscode/

# Claude
/.claude/

# build output
/build/
/app/build/

# local WiFi credentials — never committed
/app/wifi_credentials.conf

# compiled test modules and the LLVM pass plugin
/tools/*.wasm
/tools/wasp-remote-pass/*.so

# libwasp build output
/libwasp/*.so
/libwasp/src/*.o
/libwasp/test/mock_test

__pycache__/
*.pyc

# KiCad — per-user state, backups and autosaves
*.kicad_prl
*-backups/
*.lck
\#auto_saved_files\#
fp-info-cache

# Third-party KiCad libraries pulled from SnapEDA / Component Search Engine.
# Not redistributed here — re-fetch per hardware/README.md.
/hardware/lib/*
# ...except libraries we derived ourselves, which are ours to commit.
!/hardware/lib/Arduino_UNO_R3_Headers/
