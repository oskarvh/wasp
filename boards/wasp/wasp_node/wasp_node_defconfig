CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y

# SPI: the KSZ8794's management bus. Not optional on this board — port 4
# comes out of reset in RGMII mode and has to be told it is RMII, so
# without SPI there is no Ethernet.
CONFIG_SPI=y
